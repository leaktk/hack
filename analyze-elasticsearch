#!/usr/bin/env python3
import json
import sys
import requests

from urllib.parse import urlparse

def analyze(url, username, password):
    if not url.startswith("http"):
        url = f"https://{url}"
        
    results = {
        "valid": False,
        "analysis": {
            "url": url,
            "username": username,
            "password": password,
        },
    }

    try:
        resp = requests.get(
            f"{url}/_cluster/health", 
            auth=(username, password),
            timeout=10
        )
        
        if resp.status_code == 200:
            info = resp.json()
            results["valid"] = True
            results["analysis"]["cluster_name"] = info.get("cluster_name")
            results["analysis"]["status"] = info.get("status")
            results["analysis"]["number_of_nodes"] = info.get("number_of_nodes")
            results["analysis"]["number_of_data_nodes"] = info.get("number_of_data_nodes")
            results["analysis"]["active_primary_shards"] = info.get("active_primary_shards")
        elif resp.status_code == 401:
            results["valid"] = False
            results["error"] = "unauthorized"
        else:
            results["error"] = {"message": "unexpected response", "code": resp.status_code}
            
    except requests.exceptions.RequestException as e:
        results["error"] = {"message": f"request failed: {e}"}

    return results

if __name__ == "__main__":
    match len(sys.argv):
        case 2:
            netloc = urlparse(sys.argv[1]).netloc
            userinfo, url = netloc.split("@", 1)
            username, password = userinfo.split(":", 1)
            result = analyze(url, username, password)
        case 4:
            result = analyze(*sys.argv[1:])
        case _:
            print(f"USAGE: {sys.argv[0]} <url> <username> <password>")
            print(f"USAGE: {sys.argv[0]} https://<username>:<password>@url")
            sys.exit(1)

    print(json.dumps(result, indent=2))
